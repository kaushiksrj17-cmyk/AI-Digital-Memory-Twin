# ==============================================================================
# ECHO — AI Digital Memory Twin Environment Configuration (.env.example)
# Research Title: Evidence-Grounded, Privacy-Preserving Multimodal AI for
#                 Interactive Digital Memory Preservation
# ==============================================================================
# IMPORTANT:
# - All storage paths must reside inside D:\ECHO.
# - Do NOT commit your actual .env file or production keys.
# - All AI responses must explicitly identify as AI-generated memorial representations.
# ==============================================================================

# Application Environment
ENVIRONMENT=development  # Local: "development" | Railway: "production"
DEBUG=True               # Local: True | Railway: False
PROJECT_NAME="ECHO — AI Digital Memory Twin"
PROJECT_ROOT="D:\ECHO"   # Local default: "D:\ECHO" | Railway container: "/app"
API_V1_STR="/api/v1"
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
FRONTEND_URL=http://localhost:3000

# CORS & Networking Configuration
# Comma-delimited list of allowed origins. In Railway, include your deployed Vercel frontend domain:
# e.g., CORS_ORIGINS="http://localhost:3000,https://<your-project>.vercel.app"
CORS_ORIGINS="http://localhost:3000,http://127.0.0.1:3000,http://localhost:8000,http://127.0.0.1:8000"

# Frontend Build & Proxy Configuration (Vercel)
# Set in Vercel project environment variables to route /api/v1/... to Railway:
# BACKEND_API_URL="https://<your-railway-backend>.up.railway.app"
BACKEND_API_URL="http://127.0.0.1:8000"

# Security & Cryptography
# Generate a strong 32+ character random string for production (e.g. `openssl rand -hex 32`)
SECRET_KEY="REPLACE_WITH_SECURE_RANDOM_SECRET_KEY_MIN_32_CHARS"
ACCESS_TOKEN_EXPIRE_MINUTES=11520
ALGORITHM="HS256"

# Database Configuration
# Local default (SQLite): "sqlite+aiosqlite:///D:/ECHO/storage/local/echo_dev.db"
# Railway with Persistent Volume mounted at /app/storage/local:
# DATABASE_URL="sqlite+aiosqlite:////app/storage/local/echo_dev.db"
# Optional PostgreSQL (if provisioned): "postgresql+asyncpg://user:pass@host:5432/db"
DATABASE_URL="sqlite+aiosqlite:///D:/ECHO/storage/local/echo_dev.db"
DATABASE_ECHO=False

# Vector Database Abstraction
VECTOR_DATABASE_URL="qdrant://localhost:6333/echo_memories"
VECTOR_COLLECTION_NAME="echo_evidence_vectors"
VECTOR_DIMENSION=1536

# Knowledge Graph Database Abstraction
GRAPH_DATABASE_URL="bolt://localhost:7687"
GRAPH_DATABASE_USER="neo4j"
GRAPH_DATABASE_PASSWORD="REPLACE_WITH_NEO4J_PASSWORD"

# AI Provider Configurations (Replace with authorized keys when deploying)
# Notice: When unconfigured, ECHO gracefully returns "UNCONFIGURED" status without fabricating responses.
LLM_PROVIDER="mock"  # options: "mock", "gemini", "openai", "anthropic", "local"
LLM_API_KEY=""
LLM_MODEL="gemini-1.5-pro"

EMBEDDING_PROVIDER="mock"  # options: "mock", "gemini", "openai", "sentence-transformers"
EMBEDDING_API_KEY=""
EMBEDDING_MODEL="text-embedding-004"

STT_PROVIDER="mock"  # Speech-to-Text: "mock", "whisper", "deepgram", "google-speech"
STT_API_KEY=""

TTS_PROVIDER="mock"  # Text-to-Speech: "mock", "elevenlabs", "coqui", "google-tts"
TTS_API_KEY=""

CV_PROVIDER="mock"  # Computer Vision: "mock", "gemini-vision", "yolo", "florence2"
CV_API_KEY=""

OCR_PROVIDER="mock"  # Optical Character Recognition: "mock", "tesseract", "trocr", "google-document-ai"
OCR_API_KEY=""

# Local Private Storage Configuration (Strictly within D:\ECHO)
STORAGE_ROOT="D:\ECHO\storage\local"
MAX_UPLOAD_SIZE_MB=500
ENABLE_ENCRYPTION_AT_REST=False
STORAGE_ENCRYPTION_KEY=""

# Ethical Guardrails & Safety Thresholds
STRICT_ETHICAL_BOUNDARIES=True
MINIMUM_EVIDENCE_CONFIDENCE_THRESHOLD=0.75
ALLOW_UNSUPPORTED_INFERENCES=False
SHOW_PROVENANCE_BADGES=True

# Phase 6 Voice Interaction & Memorial Voice Configuration
ENABLE_STT_MOCK=true
ENABLE_TTS_MOCK=true
VOICE_STORAGE_ROOT="D:\ECHO\storage\voice"
VOICE_WATERMARK_TAG="[ECHO-AI-MEMORIAL-VOICE-VERIFIED]"
VOICE_RETENTION_DAYS_TEMP=7
VOICE_RETENTION_DAYS_PERMANENT=365
VOICE_MAX_UPLOAD_SIZE_MB=25
CUSTOM_VOICE_PROVIDER="mock"  # options: "mock", "elevenlabs-voice-clone", "coqui-xtts"
CUSTOM_VOICE_API_KEY=""
